# BrandSync Make — standalone frontend config
#
# Copy this file to `.env.local` and fill in the values.
# Auth is a local mock SUPERADMIN user (see src/hooks/useAuth.jsx) — no Keycloak.

# ── Make generation pipeline (server-side) ──────────────────────────────────
# Postgres (e.g. Supabase) — stores patterns, projects, kit, orgs.
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Anthropic API key — used by /api/generate.
CLAUDE_API_KEY=sk-ant-...
# BrandSync MCP server — used by /api/generate for design-system tool grounding.
MCP_SERVER_URL=http://localhost:3002
MCP_SERVICE_TOKEN=

# ── Component library proxy (Strapi) ────────────────────────────────────────
# Used by /api/components and /api/product-logos.
NEXT_PUBLIC_STRAPI_API_URL=http://localhost:1337/api
STRAPI_API_TOKEN=
STRAPI_API_PROD_TOKEN=
