# BrandSync Proto — standalone frontend config
#
# This prototype depends on ONE external service: the hosted BrandSync MCP
# backend (separately hosted, shared with Make). Keycloak/Strapi/WordPress are
# eg-brandsync dependencies and are NOT required to run this standalone build —
# auth is bypassed with a local mock user (see src/hooks/useAuth.jsx).
#
# Copy this file to `.env.local` and fill in the MCP URL.

# ── Required ───────────────────────────────────────────────────────────────
# Base URL of the hosted BrandSync MCP server (issues tokens via /auth/token).
NEXT_PUBLIC_BRANDSYNC_MCP_URL=https://mcp.brand.dev.egsync.com

# ── Optional ───────────────────────────────────────────────────────────────
# App environment label (local | dev | prod). Controls minor UI behavior.
NEXT_PUBLIC_APP_ENV=local
# Skip the eg-brandsync VPN reachability banner in the standalone build.
NEXT_PUBLIC_SKIP_VPN_CHECK=true

# ── Not used by the standalone build (eg-brandsync only) ─────────────────────
# Strapi CMS (design-system assets), Keycloak (SSO), WordPress (landing) and
# the server-side Make pipeline (DATABASE_URL / CLAUDE_API_KEY / MCP_SERVICE_TOKEN)
# are intentionally omitted. Add them back only if you re-introduce those features.
